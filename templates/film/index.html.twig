{% extends 'base.html.twig' %}

{% block title %}Films BelgianProd{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

    <h1>Films BelgianProd</h1>
    <ul>
    {% for film in films %}
       <li>
            <h2>{{ film.titre }} - {{ film.description }} - {{ film.categorie.nom }} </h2>
        </li> 
    
        </ul>

        <ul>
            {% for acteur in film.acteurs %}
                <li>
                    <h2>{{ acteur.nom }} - {{ acteur.prenom }}</h2>
                </li>
            {% endfor %}
        </ul>        

    {% endfor %}    
    </ul>
{% endblock %}

 

{% extends 'base.html.twig' %}

{% block title %}{{ film.titre }}{% endblock %}

{%  block body %}

    <h1>{{ film.titre|upper }}</h1>

    {% if film.description %}
        <p>{{ film.description }}</p>
    {% else %}
        <p>Pas de description pour ce film.</p>
    {% endif %}

    <ul>
        {% for acteur in film.acteurs %}       
            <li>{{ acteur.nom|upper }} - {{ acteur.prenom }} - 
                {# {% if acteur.sexe == 'M' %}
                    né le
                {% else %}
                    née le
                {% endif %} #}   

                {#  version courte (opérateur ternaire) #}
                {{ acteur.sexe == 'M' ? 'né' : 'née' }} le  
                 {{ acteur.dateNaissance|date('d/m/Y') }}</li>
                
                 

        {% else %}
            <li>Aucun acteur</li>
        {% endfor %}        
    </ul>

    <p>Catégorie : {{ film.categorie.nom }}</p>



    <a href="{{ path('app_film') }}">Retour à la liste</a>

{% endblock %}    
